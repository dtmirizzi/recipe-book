# Local Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://recipebook:recipebook@localhost:5433/recipebook

# Auth.js
AUTH_SECRET=dev-secret-change-me-please-32-chars-min
NEXTAUTH_URL=http://localhost:3000

# Resend (magic-link email). Optional locally; the dev credentials
# provider works without it. Set this to enable real magic links.
RESEND_API_KEY=
EMAIL_FROM=Recipe Box <hello@example.com>

# OpenRouter (capture + smart-search). Optional locally; mock extractor
# is used when unset. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Defaults are tuned for cost — Gemini 2.5 Flash handles both text and vision.
# Bump to a stronger model only if you find extraction quality lacking.
#
# Cost tiers (rough OpenRouter prices, $/1M tokens, in/out — verify on the dashboard):
#   cheapest:   google/gemini-2.5-flash-lite   ~$0.10 / $0.40
#   default:    google/gemini-2.5-flash        ~$0.30 / $2.50
#   balanced:   openai/gpt-4o-mini             ~$0.15 / $0.60
#   premium:    anthropic/claude-haiku-4.5     ~$1.00 / $5.00   (text)
#   premium:    anthropic/claude-sonnet-4.5    ~$3.00 / $15.00  (vision)
#
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL_TEXT=google/gemini-2.5-flash
# OPENROUTER_MODEL_VISION=google/gemini-2.5-flash
# OPENROUTER_APP_NAME=Recipe Box
# OPENROUTER_APP_URL=https://example.com

# Vercel Blob (recipe photos). Optional locally; filesystem fallback
# at ./public/uploads/ is used when unset.
BLOB_READ_WRITE_TOKEN=

# App-level toggles
NODE_ENV=development
