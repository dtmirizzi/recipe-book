# Local Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://recipebook:recipebook@localhost:5433/recipebook

# Auth.js
AUTH_SECRET=dev-secret-change-me-please-32-chars-min
NEXTAUTH_URL=http://localhost:3000

# Resend (magic-link email). Optional locally; the dev credentials
# provider works without it. Set this to enable real magic links.
RESEND_API_KEY=
EMAIL_FROM=Recipe Box <hello@example.com>

# OpenRouter (capture + smart-search). Optional locally; mock extractor
# is used when unset. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional overrides — defaults are good unless you want a different model.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL_TEXT=anthropic/claude-haiku-4.5
# OPENROUTER_MODEL_VISION=anthropic/claude-sonnet-4.5
# OPENROUTER_APP_NAME=Recipe Box
# OPENROUTER_APP_URL=https://example.com

# Vercel Blob (recipe photos). Optional locally; filesystem fallback
# at ./public/uploads/ is used when unset.
BLOB_READ_WRITE_TOKEN=

# App-level toggles
NODE_ENV=development
