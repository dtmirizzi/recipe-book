# Local Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://recipebook:recipebook@localhost:5433/recipebook

# Auth.js
AUTH_SECRET=dev-secret-change-me-please-32-chars-min
NEXTAUTH_URL=http://localhost:3000

# Resend (magic-link email). Optional locally; the dev credentials
# provider works without it. Set this to enable real magic links.
RESEND_API_KEY=
EMAIL_FROM=Recipe Box <hello@example.com>

# Anthropic (capture + smart-search). Optional locally; mock extractor
# is used when unset.
ANTHROPIC_API_KEY=

# Vercel Blob (recipe photos). Optional locally; filesystem fallback
# at ./public/uploads/ is used when unset.
BLOB_READ_WRITE_TOKEN=

# App-level toggles
NODE_ENV=development
